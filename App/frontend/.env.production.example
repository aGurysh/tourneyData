# Optional: copy to .env.production.local, or set in your frontend build service.
# Same-origin hosting: your production web server forwards /api to FastAPI.
VITE_API_BASE_URL=/api

# Separate API host: use its public HTTPS URL instead, and set the backend's
# CORS_ORIGINS to your frontend origin (scheme + host + optional port).
# VITE_API_BASE_URL=https://api.example.com
# VITE_* values are public and baked into the bundle at build time.
