# Include in Nginx's http context (for example, /etc/nginx/conf.d/tourney.conf).
# Example: Nginx and FastAPI run on the same host, with HTTPS terminated by
# an upstream load balancer. For direct public hosting, configure HTTPS here.
server {
    listen 80;
    server_name tourney.example.com;

    # Copy App/frontend/dist contents here after npm ci && npm run build.
    root /srv/tourney/frontend;
    index index.html;

    location = /api {
        return 308 /api/$is_args$args;
    }

    location /api/ {
        # The trailing slash strips /api/: /api/tournaments -> /tournaments.
        # Change the upstream address if FastAPI runs on another host/container.
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
